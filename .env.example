PORT=3000

# fatal | error | warn | info | debug | trace | silent. "debug" also logs raw provider
# responses (phone numbers and message content, never credentials) - avoid in production.
LOG_LEVEL=info

# Public URL of this server (e.g. an ngrok/Railway URL). Used to build provider status callback URLs.
# Optional for now; when unset, no status callback URL is sent to the provider.
PUBLIC_BASE_URL=

# Temporary POC auth for /api routes: clients send it in the x-api-key header. Min 16 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Neon Postgres. Both URLs point at the same database:
# DATABASE_URL - pooled connection (host contains "-pooler"). Used by the app at runtime.
# DIRECT_URL   - direct connection (same host without "-pooler"). Used only by the Prisma CLI
#                (npm run db:migrate / db:studio), since migrations don't work reliably through the pooler.
DATABASE_URL=
DIRECT_URL=

# Tests only (npm test): a separate, disposable database. Tables are truncated between tests and migrations
# are applied automatically. The suite refuses to run if these are missing or point at DATABASE_URL/DIRECT_URL.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# GoHighLevel OAuth app (Marketplace > My Apps > Advanced Settings > Auth > Client Keys).
# Optional for now; the OAuth Redirect URL to register is PUBLIC_BASE_URL + "/oauth/callback" (or GHL_OAUTH_REDIRECT_URI).
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Optional. The Redirect URL registered on the GHL app, sent as redirect_uri when exchanging/refreshing tokens.
# Defaults to PUBLIC_BASE_URL + "/oauth/callback". Set it when the registered URL differs from where this server
# runs, e.g. GHL rejects changing tunnel URLs, so the POC registers https://example.com/oauth/callback. In that
# case GHL redirects the browser to that URL after install: copy the "code" from the address bar and open
# PUBLIC_BASE_URL/oauth/callback?code=<code> yourself (codes expire quickly).
GHL_OAUTH_REDIRECT_URI=
# Optional. Our custom conversation provider's id (Marketplace app > Conversation Providers). Saved on each
# location at install; without it inbound replies are stored locally but not added to GHL Conversations.
GHL_CONVERSATION_PROVIDER_ID=
# Optional. "Version" header sent to the GHL API (current docs: v3).
GHL_API_VERSION=v3
# Optional. Ed25519 public key (PEM) for verifying X-GHL-Signature on the Delivery URL. Defaults to the key
# published in GHL's Webhook Integration Guide; set only if GHL rotates it. "\n" escapes are accepted.
GHL_WEBHOOK_PUBLIC_KEY=

# Required. AES-256-GCM key for GHL tokens at rest (32 random bytes, base64). Changing it makes stored
# tokens unreadable, so locations would have to reinstall. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

IMESSAGE_PROVIDER=mock

# Required when IMESSAGE_PROVIDER=sendblue
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# Optional
SENDBLUE_BASE_URL=https://api.sendblue.com
# Secret configured on Sendblue webhooks; sent back in the sb-signing-secret header
SENDBLUE_WEBHOOK_SECRET=
